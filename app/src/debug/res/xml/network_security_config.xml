<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only (release uses src/main's strict config). Same as release, plus cleartext to
  this device's own loopback address, so on-device integration tests can point the downloader at
  a local fake HTTP server. Nothing off the device is reachable over cleartext.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
