<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup and device-to-device transfer rules (android:dataExtractionRules).

  allowBackup="false" in the manifest already disables cloud backup, but on Android 12+ it does
  NOT stop device-to-device transfer when a user sets up a new phone. Exclude only the
  HuggingFace login (its own preferences file, ModelManager.AUTH_PREFS): a saved OAuth token
  shouldn't be copied to another device. Downloaded models, history and settings still move, so
  the new phone only needs a fresh HuggingFace sign-in.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="hf_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="hf_auth.xml" />
    </device-transfer>
</data-extraction-rules>
